rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    // Only verified accounts from the allowed email domain(s) can use the app.
    // Keep this list in sync with ALLOWED_EMAIL_DOMAINS in src/lib/firebase.ts
    function isSignedIn() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('.*@thapar[.]edu$');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isFullMember(projectId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members
        )
      );
    }

    function isProjectMember(projectId) {
      return isFullMember(projectId) || (isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.get('guests', []));
    }

    function canReadChannel(projectId, channelId) {
      return isFullMember(projectId) || (isProjectMember(projectId) &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)/channels/$(channelId)).data.get('members', []));
    }

    function isChannelRecruiter(projectId, channelId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      let channel = get(/databases/$(database)/documents/projects/$(projectId)/channels/$(channelId)).data;
      let adminId = channel.get('adminId', '');
      let assigned = adminId == project.ownerId || adminId in project.members || adminId in project.get('guests', []);
      return project.ownerId == request.auth.uid || request.auth.uid == (assigned ? adminId : project.ownerId);
    }

    function validInvitation(projectId) {
      let token = getAfter(/databases/$(database)/documents/projects/$(projectId)/joinRequests/$(request.auth.uid)).data.token;
      let invite = get(/databases/$(database)/documents/recruitInvites/$(token)).data;
      return invite.projectId == projectId && invite.expiresAt > request.time.toMillis();
    }

    function invitationScope(projectId) {
      let token = getAfter(/databases/$(database)/documents/projects/$(projectId)/joinRequests/$(request.auth.uid)).data.token;
      return get(/databases/$(database)/documents/recruitInvites/$(token)).data;
    }

    function addsSelf(before, after) {
      return after is list && after.toSet() == before.toSet().union([request.auth.uid].toSet()) &&
        after.size() >= before.size() && after.size() <= before.size() + 1;
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.id is string && isValidId(data.id) &&
             data.channelId is string && isValidId(data.channelId) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.content is string && data.content.size() <= 5000 &&
             (data.content.size() > 0 || data.keys().hasAny(['codeSnippet']));
    }

    // Any project member may toggle reactions on any message, but change nothing else
    function isReactionOnlyUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) &&
             incoming().reactions is map;
    }

    // A signed-in user who knows the project id (shared via invite link) may add
    // exactly themselves to `members` - and change nothing else.
    function isSelfJoin(projectId) {
      let invite = invitationScope(projectId);
      return validInvitation(projectId) && (
        (invite.scope == 'workspace' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['members', 'guests']) &&
          addsSelf(existing().members, incoming().members) &&
          incoming().get('guests', []).toSet() == existing().get('guests', []).toSet().difference([request.auth.uid].toSet())) ||
        (invite.scope == 'channel' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['guests']) &&
          addsSelf(existing().get('guests', []), incoming().guests))
      );
    }

    function isValidMember(memberId, data) {
      return data.id == memberId &&
             data.name is string && data.name.size() <= 100 &&
             (!data.keys().hasAny(['skills']) || (data.skills is list && data.skills.size() <= 30)) &&
             (!data.keys().hasAny(['role']) || (data.role is string && data.role.size() <= 80));
    }

    function isValidTask(data) {
      return data.id is string && isValidId(data.id) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['backlog', 'todo', 'in_progress', 'review', 'completed'] &&
             data.priority in ['urgent', 'high', 'medium', 'low'] &&
             data.completed is bool;
    }

    function isValidDecision(data) {
      return data.id is string && isValidId(data.id) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['confirmed', 'proposed', 'superseded', 'deprecated'];
    }

    match /recruitInvites/{token} {
      allow get: if isSignedIn();
      allow list, delete: if isProjectOwner(resource.data.projectId);
      allow create: if isSignedIn() && isValidId(token) &&
        incoming().keys().hasOnly(['projectId', 'channelId', 'scope', 'createdBy', 'expiresAt']) &&
        incoming().createdBy == request.auth.uid &&
        incoming().expiresAt > request.time.toMillis() &&
        incoming().expiresAt <= request.time.toMillis() + 604800000 &&
        ((incoming().scope == 'workspace' && incoming().channelId == null && isProjectOwner(incoming().projectId)) ||
         (incoming().scope == 'channel' && canReadChannel(incoming().projectId, incoming().channelId) &&
          isChannelRecruiter(incoming().projectId, incoming().channelId)));
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (!exists(/databases/$(database)/documents/projects/$(projectId)) || resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members || request.auth.uid in resource.data.get('guests', []));
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members || request.auth.uid in resource.data.get('guests', []));
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isProjectOwner(projectId) &&
                   incoming().ownerId == existing().ownerId;
      allow update: if isSignedIn() && isValidId(projectId) && isSelfJoin(projectId);
      allow delete: if isSignedIn() && isValidId(projectId) && isProjectOwner(projectId);

      match /joinRequests/{memberId} {
        allow list, delete: if isProjectOwner(projectId);
        allow get: if isSignedIn() && memberId == request.auth.uid;
        allow create, update: if isSignedIn() && memberId == request.auth.uid &&
          incoming().keys().hasOnly(['token']) &&
          incoming().token is string &&
          get(/databases/$(database)/documents/recruitInvites/$(incoming().token)).data.projectId == projectId &&
          get(/databases/$(database)/documents/recruitInvites/$(incoming().token)).data.expiresAt > request.time.toMillis();
      }

      // Channels subcollection
      match /channels/{channelId} {
        allow get, list: if isFullMember(projectId) || (isProjectMember(projectId) && request.auth.uid in resource.data.get('members', []));
        allow create: if isProjectOwner(projectId) && isValidId(channelId) &&
                      incoming().get('adminId', '') == request.auth.uid;
        allow update: if isProjectOwner(projectId) && isValidId(channelId) &&
                      !incoming().diff(existing()).affectedKeys().hasAny(['adminId', 'theme', 'members']);
        allow update: if isProjectMember(projectId) && isValidId(channelId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['theme']) &&
                      (incoming().theme == null || incoming().theme in ['pokemon', 'avengers', 'harry-potter', 'whimsy']) &&
                      isProjectOwner(projectId);

        allow update: if isSignedIn() && isValidId(channelId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['members']) &&
          addsSelf(existing().get('members', []), incoming().members) &&
          validInvitation(projectId) && invitationScope(projectId).scope == 'channel' &&
          invitationScope(projectId).channelId == channelId;

        allow update: if isProjectOwner(projectId) && isValidId(channelId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['adminId']) &&
                      incoming().adminId is string &&
                      (incoming().adminId == request.auth.uid ||
                       incoming().adminId in get(/databases/$(database)/documents/projects/$(projectId)).data.members);
        allow delete: if isProjectOwner(projectId) && isValidId(channelId);

        // Messages subcollection
        match /messages/{messageId} {
          allow get, list: if canReadChannel(projectId, channelId);
          allow create: if canReadChannel(projectId, channelId) && isValidId(messageId) && isValidMessage(incoming());
          allow update: if canReadChannel(projectId, channelId) && isValidId(messageId) &&
                       existing().senderId == request.auth.uid &&
                       incoming().senderId == existing().senderId &&
                       isValidMessage(incoming());
          allow update: if canReadChannel(projectId, channelId) && isReactionOnlyUpdate();
          allow delete: if canReadChannel(projectId, channelId) && (existing().senderId == request.auth.uid || isProjectOwner(projectId));
        }
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list: if isFullMember(projectId);
        allow create: if isFullMember(projectId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if isFullMember(projectId) && isValidId(taskId) && isValidTask(incoming()) &&
                     incoming().projectId == existing().projectId;
        allow delete: if isFullMember(projectId) && isValidId(taskId);
      }

      // Member profiles (name, role, skills, presence) - you can only edit your own
      match /members/{memberId} {
        allow get, list: if isProjectMember(projectId);
        allow create, update: if isProjectMember(projectId) && request.auth.uid == memberId &&
                             isValidMember(memberId, incoming());
        allow delete: if request.auth.uid == memberId || isProjectOwner(projectId);
      }

      // Saved AI analysis per channel (summary, proposed tasks, open questions) shared with the team
      match /analyses/{channelId} {
        allow get, list: if isProjectOwner(projectId) || canReadChannel(projectId, channelId);
        allow create, update, delete: if canReadChannel(projectId, channelId) && isValidId(channelId);
      }

      // Decisions subcollection
      match /decisions/{decisionId} {
        allow get, list: if isFullMember(projectId);
        allow create: if isFullMember(projectId) && isValidId(decisionId) && isValidDecision(incoming());
        allow update: if isFullMember(projectId) && isValidId(decisionId) && isValidDecision(incoming()) &&
                     incoming().projectId == existing().projectId;
        allow delete: if isFullMember(projectId) && isValidId(decisionId);
      }
    }
  }
}
