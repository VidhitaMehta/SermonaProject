rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members
        )
      );
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.id is string && isValidId(data.id) &&
             data.channelId is string && isValidId(data.channelId) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000;
    }

    function isValidTask(data) {
      return data.id is string && isValidId(data.id) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['backlog', 'todo', 'in_progress', 'review', 'completed'] &&
             data.priority in ['urgent', 'high', 'medium', 'low'] &&
             data.completed is bool;
    }

    function isValidDecision(data) {
      return data.id is string && isValidId(data.id) &&
             data.projectId is string && isValidId(data.projectId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['confirmed', 'proposed', 'deprecated'];
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isProjectOwner(projectId) &&
                   incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(projectId) && isProjectOwner(projectId);

      // Channels subcollection
      match /channels/{channelId} {
        allow get, list: if isProjectMember(projectId);
        allow create, update: if isProjectMember(projectId) && isValidId(channelId);
        allow delete: if isProjectOwner(projectId) && isValidId(channelId);

        // Messages subcollection
        match /messages/{messageId} {
          allow get, list: if isProjectMember(projectId);
          allow create: if isProjectMember(projectId) && isValidId(messageId) && isValidMessage(incoming());
          allow update: if isProjectMember(projectId) && isValidId(messageId) &&
                       existing().senderId == request.auth.uid &&
                       incoming().senderId == existing().senderId &&
                       isValidMessage(incoming());
          allow delete: if isProjectMember(projectId) && (existing().senderId == request.auth.uid || isProjectOwner(projectId));
        }
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if isProjectMember(projectId) && isValidId(taskId) && isValidTask(incoming()) &&
                     incoming().projectId == existing().projectId;
        allow delete: if isProjectMember(projectId) && isValidId(taskId);
      }

      // Decisions subcollection
      match /decisions/{decisionId} {
        allow get, list: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidId(decisionId) && isValidDecision(incoming());
        allow update: if isProjectMember(projectId) && isValidId(decisionId) && isValidDecision(incoming()) &&
                     incoming().projectId == existing().projectId;
        allow delete: if isProjectMember(projectId) && isValidId(decisionId);
      }
    }
  }
}
